
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Publicly readable collections for guests
    match /shopOwnerProfiles/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
    match /reviews/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /requirements/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /updates/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default to authenticated access for all other collections
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
